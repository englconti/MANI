<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · MANI" : "MANI" %></title>

    <!-- FAVICON ITEM MANI INVEST -->
    <link rel="icon" href="https://res.cloudinary.com/guijafrone/image/upload/v1654712310/MANI%20GAMES/favicon_vsn2fs.gif" type="image/x-icon">

    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbo-track': 'reload', type: 'module' %>
  </head>

  <body>
    <!--div #body-container added by Leo to add background-color to entire site -->
    <div id="body-container">
      <%= render 'shared/navbar' unless @disable_nav %>
      <!--Alerts for everything-->
      <%= render 'shared/flashes' %>

      <%= yield %>
    </div>
  </body>
</html>
