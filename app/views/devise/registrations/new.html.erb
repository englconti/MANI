<% content_for :title, "Criar conta" %>
<div class="auth-page">
  <div class="auth-card container-new-user-form" data-controller="password">
    <h1>Crie sua conta</h1>
    <p class="auth-lead">É grátis e leva menos de um minuto.</p>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= f.error_notification %>

      <div class="form-inputs">
        <%= f.input :username,
                    required: true,
                    autofocus: true,
                    input_html: { autocomplete: "username" } %>

        <%= f.input :email,
                    required: true,
                    input_html: { autocomplete: "email" } %>

        <%# Native date picker; the value is formatted for <input type="date"> %>
        <%= f.input :birthday,
                    as: :string,
                    required: true,
                    input_html: { type: "date",
                                  min: "1922-12-31",
                                  max: Date.current.iso8601,
                                  value: f.object.birthday&.to_date&.iso8601,
                                  autocomplete: "bday" } %>

        <%= f.input :password,
                    required: true,
                    hint: ("mínimo de #{@minimum_password_length} caracteres" if @minimum_password_length),
                    input_html: { autocomplete: "new-password", data: { password_target: "field" } } %>

        <%= f.input :password_confirmation,
                    required: true,
                    input_html: { autocomplete: "new-password", data: { password_target: "field" } } %>

        <label class="auth-show-password">
          <input type="checkbox" data-action="password#toggle"> Mostrar senhas
        </label>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Cadastrar", class: "mani-btn mani-btn-primary btn-sign-up" %>
      </div>
    <% end %>

    <div class="auth-links">
      <span>Já tem conta? <%= link_to "Entrar", new_session_path(resource_name) %></span>
    </div>
  </div>
</div>
