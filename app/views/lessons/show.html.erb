<% content_for :title, "Resumo da aula" %>
<% total = @questions.size %>
<% percent = total.zero? ? 0 : (@true_count * 100.0 / total).round %>
<% stars = percent == 100 ? 3 : percent >= 60 ? 2 : 1 %>
<% headline = percent == 100 ? "Aula perfeita!" : percent >= 60 ? "Muito bem!" : "Aula concluída!" %>
<% encouragement = percent == 100 ? "Você gabaritou. Seu dinheiro agradece!" : percent >= 60 ? "Quase lá: refazer a aula rende mais pontos." : "Errar faz parte. Refaça a aula para ganhar mais XP." %>
<% streak = current_user.current_streak %>

<div class="finish-page" data-controller="celebration" data-celebration-stars-value="<%= stars %>">
  <div class="finish-card">
    <div class="finish-mascot" aria-hidden="true"><%= mascot_tag(percent == 100 ? "pig-cheering" : percent >= 60 ? "pig-sunglasses" : "pig-thinking") %></div>
    <h1><%= headline %></h1>
    <p class="finish-lesson"><%= @lesson.title %></p>

    <div class="finish-stars" role="img" aria-label="<%= stars %> de 3 estrelas">
      <% 3.times do |i| %><span class="<%= 'off' if i >= stars %>" aria-hidden="true"><%= mani_icon(:star) %></span><% end %>
    </div>

    <dl class="finish-stats">
      <div class="is-score">
        <dt>Acertos</dt>
        <dd><%= @true_count %> / <%= total %></dd>
      </div>
      <div class="is-xp">
        <dt>XP</dt>
        <dd>+<span data-celebration-target="number" data-celebration-value="<%= @xp_gained %>"><%= @xp_gained %></span></dd>
      </div>
      <div class="is-manis">
        <dt>M$</dt>
        <dd>+<span data-celebration-target="number" data-celebration-value="<%= @manis_gained %>"><%= @manis_gained %></span></dd>
      </div>
    </dl>

    <p class="finish-note">
      <%= @xp_gained.zero? ? "Sem pontos novos desta vez: só melhorar a sua nota rende mais." : encouragement %>
    </p>

    <% if @level_up %>
      <p class="finish-banner">Você subiu para o nível <%= @level_up.number %>: <strong><%= @level_up.name %></strong>!</p>
    <% end %>
    <% if @goal_reached_now %>
      <p class="finish-banner">Meta do dia batida!</p>
    <% end %>

    <div class="finish-chips">
      <span class="status-chip is-streak" title="Dias seguidos estudando"><%= mani_icon(:flame) %> <%= streak %> <%= streak == 1 ? "dia" : "dias" %></span>
      <span class="status-chip is-lives" title="Vidas restantes"><%= mani_icon(:heart) %> <%= current_user.lives %> <%= current_user.lives == 1 ? "vida" : "vidas" %></span>
    </div>

    <p class="disclaimer">Conteúdo educacional. Não é recomendação de investimento.</p>

    <div class="finish-actions">
      <%= link_to "Continuar", user_path(current_user), class: "mani-btn mani-btn-primary", id: "btn-lesson-page-to-user-page" %>
      <% if current_user.out_of_lives? %>
        <%= link_to "Sem vidas: veja quando voltam", no_lives_path, class: "mani-btn mani-btn-ghost" %>
      <% else %>
        <% if @wrong_count.positive? %>
          <%= button_to "Refazer só as que errei (#{@wrong_count})", retry_wrong_lesson_path(@lesson), method: :post,
                        id: "btn-retry-wrong", class: "mani-btn mani-btn-secondary" %>
        <% end %>
        <%= button_to "Refazer aula", restart_lesson_path(@lesson), method: :post, id: "btn-redo-lesson",
                      class: "mani-btn mani-btn-ghost" %>
      <% end %>
      <% if @lesson.intro? %>
        <%= link_to "Ver a introdução da aula", intro_lesson_path(@lesson), id: "btn-lesson-intro", class: "mani-btn mani-btn-ghost" %>
      <% end %>
      <%= link_to "Praticar sem perder vidas", question_path(@lesson.questions.first, practice: 1),
                  id: "btn-practice", class: "mani-btn mani-btn-ghost" %>
    </div>
  </div>
</div>
