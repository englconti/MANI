<% content_for :title, @lesson.intro_title.presence || @lesson.title %>
<div class="intro-page">
  <div class="intro-card">
    <div class="intro-art" aria-hidden="true"><%= lesson_image_tag(@lesson) %></div>
    <h1><%= @lesson.intro_title.presence || @lesson.title %></h1>
    <% @lesson.intro_paragraphs.each do |paragraph| %>
      <p><%= paragraph %></p>
    <% end %>
    <p class="intro-meta"><%= @lesson.title %> · <%= @question_count %> <%= @question_count == 1 ? "pergunta" : "perguntas" %></p>

    <div class="intro-actions">
      <%= link_to "Começar a aula", question_path(@lesson.questions.first, skip_intro: 1),
                  id: "btn-start-lesson", class: "mani-btn mani-btn-primary" %>
      <%= link_to "Voltar à trilha", user_path(current_user), class: "mani-btn mani-btn-ghost" %>
    </div>
  </div>
</div>
