<nav class="navbar navbar-expand-sm navbar-light navbar-lewagon" aria-label="Principal">
  <div class="container-fluid">
    <div class="nav-left-box">
      <%= link_to root_path, class: "navbar-brand" do %>
        <%= image_tag "Mani-oficial-bg.png" %>
      <% end %>
      <% if @show_user_info %>
        <p id="user-page-greeting">Olá, <%= current_user.username.capitalize %>! Bora aprender com o Mani?</p>
      <% end %>
    </div>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Abrir ou fechar o menu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto">
        <% if user_signed_in? %>

          <!-- Removing dashboard button from dashboard page-->
          <% unless @disable_dashboard_button %>
            <li class="nav-item active">
              <%= link_to "Home", root_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Meu dashboard", user_path(current_user), class: "nav-link" %>
            </li>
          <% end %>
          <li class="nav-item">
            <%= link_to "Simulador", simulator_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Loja", store_path, class: "nav-link" %>
          </li>
          <!-- end -->

          <% if @show_user_info %>

              <li class="box-user-info" aria-label="Meu status">
                <span class="status-chip is-xp"><%= current_user.xp %> XP</span>
                <%= link_to store_path, class: "status-chip is-manis", title: "Gastar M$ na Mani Store" do %><%= current_user.manis %> M$<% end %>

                <% streak = current_user.current_streak %>
                <span class="status-chip is-streak" title="Dias seguidos estudando"><%= mani_icon(:flame) %> <%= streak %><span class="visually-hidden"> <%= streak == 1 ? "dia seguido" : "dias seguidos" %></span></span>
                <span class="status-chip is-lives" title="Vidas"><%= mani_icon(:heart) %> <%= current_user.lives %><span class="visually-hidden"> <%= current_user.lives == 1 ? "vida" : "vidas" %></span></span>
              </li>
          <% end %>

          <li class="nav-item dropdown">
            <button type="button" class="avatar-button dropdown-toggle" id="navbarDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu da conta">
              <%= avatar_tag(current_user, class: "avatar") %>
            </button>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
              <%= link_to "Meu perfil", user_path(current_user), class: "dropdown-item" %>
              <%= link_to "Editar dados", edit_user_registration_path, class: "dropdown-item" %>
              <%= link_to "Sair", destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item" %>
            </div>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Cadastre-se", new_user_registration_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Entrar", new_user_session_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
