<ul class="trail-legend" aria-label="Legenda da trilha">
  <li><%= mani_icon(:play) %> Aberta (pode começar)</li>
  <li><%= mani_icon(:lock) %> Bloqueada</li>
  <li><%= mani_icon(:check) %> Concluída (100%)</li>
  <li><%= mani_icon(:retry) %> Concluída com erros (refaça para 100%)</li>
</ul>

<ol class="lesson-tracks" aria-label="Trilhas de aulas">
  <% tracks.each do |track| %>
    <li class="track">
      <h2 class="track-title"><%= track.subject %></h2>
      <ol class="track-path">
        <% track.nodes.each do |node| %>
          <% lesson = node.lesson %>
          <% icon = mani_icon(node.perfect? ? :check : node.completed? ? :retry : node.available? ? :play : :lock) %>
          <% status = node.completed? ? "concluída#{node.perfect? ? "" : " com erros"}, #{node.correct} de #{node.total} acertos" : node.available? ? "aberta" : "bloqueada" %>
          <% recommended_now = node.available? && lesson == recommended %>
          <li class="trail-node is-<%= node.state %><%= " is-recommended" if recommended_now %><%= " is-imperfect" if node.completed? && !node.perfect? %>">
            <div class="trail-body">
              <% if node.locked? %>
                <span class="trail-link" role="img" aria-label="<%= lesson.title %>: <%= status %>">
                  <span class="trail-icon" aria-hidden="true"><%= icon %></span>
                </span>
              <% else %>
                <%= link_to question_path(lesson.questions.first), class: "trail-link",
                            style: "--p: #{node.percent}",
                            "aria-label": "#{lesson.title}: #{status}" do %>
                  <span class="trail-icon" aria-hidden="true"><%= icon %></span>
                <% end %>
              <% end %>

              <span class="trail-title"><span class="visually-hidden"><%= lesson.title %></span><span aria-hidden="true"><%= lesson.subject == track.subject ? "Nível #{lesson.level}" : lesson.subject %></span></span>
              <% if node.available? %>
                <span class="trail-start"><%= recommended_now ? "Próxima" : "Começar" %></span>
              <% elsif node.completed? %>
                <span class="trail-stars" aria-hidden="true">
                  <% 3.times do |i| %><span class="<%= 'off' if i >= node.stars %>"><%= mani_icon(:star) %></span><% end %>
                </span>
                <span class="trail-meta"><%= node.correct %> / <%= node.total %> acertos</span>
                <%= link_to "Praticar", question_path(lesson.questions.first, practice: 1), class: "trail-practice",
                            "aria-label": "Praticar #{lesson.title} sem perder vidas" %>
              <% else %>
                <span class="trail-meta">Termine <%= node.prerequisite&.title %> para liberar</span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ol>
    </li>
  <% end %>
</ol>
