<% users.each do |user| %>
  <div class="friend-box-search">
    <p class="friend-username"><%= user.username %></p>
    <p class="friend-email"><%= user.email %></p>
    <% already_follow = !current_user.friendships_as_asker.find_by(receiver: user).nil?  %>
    <% if already_follow %>
      <%= button_to 'Deixar de seguir', friendship_path(receiver_username: user.username), method: 'delete', class:"btn-search-unfollow"%>
    <% else %>
      <%= button_to 'Seguir', friendships_path(receiver_username: user.username), method: 'post', class:"btn-search-follow"%>
    <% end %>
  </div>
<% end %>
