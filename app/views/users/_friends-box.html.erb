<div class="box-followers">
  <%= mani_icon(:users, class: "followers-icon") %>
  <div class="followers-block">
    <p>Seguidores</p>
    <p class="followers-numbers"><%= current_user.friendships_as_receiver.count %></p>
  </div>
  <div class="followers-block">
    <p>Seguindo</p>
    <p class="followers-numbers"><%= current_user.friendships_as_asker.count %></p>
  </div>
</div>

<div class="box-friends-list" data-controller="friends-actions">

  <%# Native dialog: Esc closes it, focus stays inside and goes back to the button that opened it %>
  <dialog class="friend-dialog" aria-labelledby="search-friend-statement"
          data-friends-actions-target="dialog"
          data-action="click->friends-actions#backdropClick close->friends-actions#reset">
    <div class="search-friend-top">
      <p id="search-friend-statement">Busque um amigo:</p>
      <div id="search-friend-bar">
        <%= form_with url: user_path, method: :get, html: { data: { friends_actions_target: 'form' } } do |f| %>
          <%= f.text_field :query,
                            class: "form-control",
                            placeholder: 'Digite um nome de usuário',
                            'aria-label': 'Buscar amigo pelo nome de usuário',
                            autocomplete: "off",
                            autofocus: true,
                            value: params[:query],
                            data: {
                                  friends_actions_target: 'searchInput',
                                  action: "input->friends-actions#update"
                                } %>
        <% end %>
      </div>
      <button type="button" class="add-friend-cancel-btn" aria-label="Fechar" data-action="click->friends-actions#closeWindow"><%= mani_icon(:close_circle) %></button>
    </div>
    <div id="users-list" data-friends-actions-target="list" aria-live="polite"></div>
  </dialog>

  <div class="box-friends-header">
    <p>Amigos</p>
    <p>XP Atual</p>
  </div>

  <div class="box-friends-friends-list">
    <% all_friends.each do |friend| %>
      <div class="friend-box">
        <p><%= friend.username.capitalize %></p>
        <p><%= friend.xp %> XP</p>
      </div>
    <% end %>
  </div>

  <footer id="friend-box-footer">
    <button type="button" class="btn btn-primary btn-add-friend" data-action="click->friends-actions#openWindow" >Add um amigo!</button>
    <button type="button" class="btn btn-send-invite" data-action="click->friends-actions#share">Compartilhar link</button>
  </footer>
  <p class="share-status" role="status" data-friends-actions-target="shareStatus"></p>

</div>
