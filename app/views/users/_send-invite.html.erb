<div class="container-window-send-invite" >
  <div class="overlay-send-invite hidden" data-action="click->friends-actions#closeInviteWindow"></div>
  <div class="box-window-send-invite hidden">
    <div class="send-invite-top">
      <p id="send-invite-statement">Digite o e-mail de quem você quer convidar</p>
      <button type="button" class="send-invite-cancel-btn" aria-label="Fechar" data-action="click->friends-actions#closeInviteWindow"><i class="fa-solid fa-circle-xmark" aria-hidden="true"></i></button>
    </div>
    <div id="send-invite-body">
      <input type="email" id="form-send-invite" aria-label="E-mail de quem você quer convidar" autocomplete="off">
      <button type="button" id="box-btn-send-invite" class="btn btn-success" data-action="click->friends-actions#sendInviteFake" >Enviar convite</button>
      <p id="blank-space-send-invite"></p>
      <p id="fake-invite-msg" style="color: white;" class="animate__animated animate__fadeIn" hidden>O envio de convites ainda está em desenvolvimento.</p>
    </div>
  </div>
</div>
