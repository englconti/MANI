<% content_for :title, "Sua trilha" %>
<div id="user-page-container">
  <div class="box-user-header">
  </div>

  <div class="container-user-show-page animate__animated animate__fadeIn">

    <%= render 'progress', user: current_user, lesson_map: @lesson_map %>

    <div class="container-lessons">
      <h1 class="trail-heading">Sua trilha</h1>
      <% available = @lesson_map.available_count %>
      <% if available > 1 %>
        <p class="trail-subtitle"><strong><%= available %> aulas abertas</strong>: escolha por onde começar.</p>
      <% elsif available == 1 %>
        <p class="trail-subtitle">Próxima aula: <strong><%= @lesson_map.current.lesson.title %></strong></p>
      <% else %>
        <p class="trail-subtitle">Você concluiu todas as aulas! <%= mani_icon(:trophy) %></p>
      <% end %>
      <%= render 'trail', tracks: @lesson_map.tracks, recommended: @lesson_map.current&.lesson %>
    </div>

    <div class="container-right-info">
      <%= render 'friends-box', all_users: @all_users, all_friends: @all_friends, ranking: @ranking %>
    </div>
  </div>
</div>
