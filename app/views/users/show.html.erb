<div id="user-page-container">
  <div class="box-user-header">
  </div>

  <div class="container-user-show-page animate__animated animate__fadeIn">

    <div class="container-lessons">
      <h1 class="trail-heading">Sua trilha</h1>
      <% if @lesson_map.current %>
        <p class="trail-subtitle">Próxima aula: <strong><%= @lesson_map.current.lesson.title %></strong></p>
      <% else %>
        <p class="trail-subtitle">Você concluiu todas as aulas! 🎉</p>
      <% end %>
      <%= render 'trail', nodes: @lesson_map.nodes %>
    </div>

    <div class="container-center-info">

      <h2>Você sabia? 🤓</h2>
      <% if @information %>
        <%= image_tag @information.img_url, style:"max-width:350px; max-height: 150px;" %>
        <p><%= @information.text %></p>
        <h6 style="font-size:10px">fonte: <a href="<%= @information.source %>" target="blank"><%= @information.source %></a></h6>
      <% end %>
    </div>

    <div class="container-right-info">
      <%= render 'friends-box', all_users: @all_users, all_friends: @all_friends %>
    </div>
</div>
