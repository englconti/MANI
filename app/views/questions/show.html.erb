<% content_for :title, "Aula" %>
<% lesson = @question.lesson %>
<% lesson_questions = @sequence %>
<% current_question_i = lesson_questions.index(@question) %>
<% next_question = lesson_questions[current_question_i + 1] %>
<% last_question = next_question.nil? %>
<% lives = current_user.lives %>

<div class="question-page"
     data-controller="lesson"
     data-action="keydown@document->lesson#key"
     data-lesson-type-value="<%= @question.question_type %>"
     data-lesson-answer-url-value="<%= answer_path(@answer_id) %>"
     data-lesson-index-value="<%= current_question_i %>"
     data-lesson-count-value="<%= lesson_questions.size %>"
     data-lesson-lives-value="<%= lives %>"
     data-lesson-next-url-value="<%= next_question ? question_path(next_question, retry: @retry_ids&.join("-"), practice: (1 if @practice)) : (@practice ? user_path(current_user) : lesson_path(lesson)) %>"
     data-lesson-review-url-value="<%= lesson_path(lesson) %>"
     data-lesson-practice-value="<%= @practice ? "true" : "false" %>"
     data-lesson-cheer-image-value="<%= image_path("mascot/pig-cheering.png") %>"
     data-lesson-cry-image-value="<%= image_path("mascot/pig-crying.png") %>"
     data-lesson-last-value="<%= last_question %>">

  <header class="question-top-part animate__animated animate__fadeIn">
    <%= link_to user_path(current_user), data: { turbo_confirm: "Tem certeza que deseja sair da aula?" },
                class: "question-cancel-btn", "aria-label": "Sair da aula" do %>
      <%= mani_icon(:close_circle) %>
    <% end %>
    <div class="bar-container-part" role="progressbar" aria-label="Progresso da aula"
         aria-valuemin="0" aria-valuemax="<%= lesson_questions.size %>" aria-valuenow="<%= current_question_i %>">
      <div class="bar-container" data-lesson-target="bar"></div>
    </div>
    <% if @practice %><span class="practice-badge">Prática<span class="practice-long">: sem perder vidas</span></span><% end %>
    <%# One heart per life: the ones already spent are greyed out %>
    <div class="hearts" role="img" aria-label="<%= lives %> <%= lives == 1 ? 'vida' : 'vidas' %>" data-lesson-target="hearts">
      <% User::MAX_LIVES.times do |index| %>
        <span class="heart<%= " is-lost" if index >= lives %>" aria-hidden="true" data-lesson-target="heart"><%= mani_icon(:heart) %></span>
      <% end %>
    </div>
  </header>

  <%# Not a <main>: a global `main` rule styles the landing page background %>
  <div class="container-question-page animate__animated animate__fadeIn" role="main">
    <div class="question-body">
      <% if @question.context.present? %>
        <aside class="question-context" aria-label="Lembrete">
          <p><%= @question.context %></p>
        </aside>
      <% end %>

      <%# The pig of the lesson asks the question; it cheers or cries when the answer comes in %>
      <div class="question-ask">
        <div class="question-pig" aria-hidden="true" data-lesson-target="pig"><%= lesson_image_tag(lesson) %></div>
        <div class="question-bubble"><%= render "questions/statement", question: @question %></div>
      </div>

      <%= render @question.question_type, question: @question %>
    </div>
  </div>

  <%# A div, not <footer>: a global `footer` rule styles the landing page footer %>
  <div class="question-footer" data-lesson-target="footer">
    <button type="button" class="sound-toggle" data-lesson-target="soundToggle" data-action="lesson#toggleSound"
            aria-pressed="true" aria-label="Desligar o som">
      <span data-sound-icon="on"><%= mani_icon(:volume_on) %></span><span data-sound-icon="off" hidden><%= mani_icon(:volume_off) %></span>
    </button>
    <div class="answer-feedback" role="status" aria-live="polite" data-lesson-target="feedback"></div>
    <div class="right-buttons">
      <button type="button" id="check-button" class="question-action" data-lesson-target="check"
              data-action="lesson#check" disabled>Verificar</button>
      <a id="continue-link" class="question-action" data-lesson-target="continue" href="#" hidden>Continuar</a>
    </div>
  </div>
</div>
