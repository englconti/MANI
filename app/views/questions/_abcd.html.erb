<h1 id="question-statement" class="question-statement"><%= question.statement %></h1>
<fieldset class="question-cards" aria-describedby="question-statement">
  <legend class="visually-hidden">Escolha uma alternativa</legend>
  <% %w[A B C D].each do |letter| %>
    <label class="question-card">
      <input type="radio" name="answer" value="<%= letter %>" class="visually-hidden"
             data-lesson-target="option" data-action="change->lesson#select">
      <span class="answer-letter" aria-hidden="true"><%= letter %></span>
      <span class="question-answer"><span class="visually-hidden">Alternativa <%= letter %>: </span><%= question.public_send(letter.downcase) %></span>
    </label>
  <% end %>
</fieldset>
